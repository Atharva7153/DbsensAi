# ==========================================
# DBSense AI - Environment Configuration
# ==========================================

# Port for Backend Server (Render automatically overrides this with its own PORT)
PORT=5001

# Internal AI Layer URL (FastAPI runs inside the same container on port 8000)
AI_LAYER_URL=http://127.0.0.1:8000

# ------------------------------------------
# LLM / AI Configuration
# ------------------------------------------
# Set to 'false' to use high-speed cloud Groq inference
USE_LOCAL_LLM=false

# Your Groq API Key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom Local LLM Gateway (ignored when USE_LOCAL_LLM=false)
# CUSTOM_AI_API_URL=http://localhost:11434/v1
# CUSTOM_AI_API_KEY=
